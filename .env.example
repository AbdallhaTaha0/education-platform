# Education platform — example environment (M3 catalog + DRM adapter)
# Copy to .env for local shell overrides. Compose files carry safe local
# defaults, so this file is documentation-first. NEVER put real production
# secrets here. Frontend (browser) configuration is prefixed VITE_ and must
# never contain privileged credentials.

# --- Platform PostgreSQL (server-only; never exposed to the browser) ---
# Local development default used by docker/compose.dev.yml:
#   postgresql://postgres:postgres@postgres:5432/education_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=education_platform
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/education_platform

# --- Platform Redis (server-only) ---
# Local development default: redis://redis:6379
REDIS_URL=redis://redis:6379

# --- Server runtime ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=0.4.0-m4
# Bounded per-dependency timeout (ms) for GET /health/ready checks.
READY_TIMEOUT_MS=2000

# --- Identity/auth (all server-only; never VITE_-prefixed) ---
# Strong signing secret, 32+ characters. Generate locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the real value in the ignored root .env only. Production fails
# closed when this is missing or weak.
AUTH_JWT_SECRET=
AUTH_ISSUER=edu-platform-dev
AUTH_AUDIENCE=edu-platform-dev-web
# Exact approved origins for state-changing identity requests (no wildcards).
ALLOWED_ORIGINS=http://localhost:8080
# Local Docker HTTP explicitly uses Secure=false. Production requires
# explicit COOKIE_SECURE=true and refuses to start otherwise.
COOKIE_SECURE=false
# Argon2id production cost (memory KiB, time, parallelism). Reduced values are
# accepted ONLY with NODE_ENV=test (isolated suites); development and
# production reject anything below 65536/3/4, and every environment rejects
# absurd values above 1048576/10/16.
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Public entry point ---
# Browser reaches the platform through Nginx, which serves the frontend and
# proxies /api/* to the backend. The frontend calls same-origin /api/*, so no
# browser-side backend URL is required.
PUBLIC_BASE_URL=http://localhost:8080

# --- No-DRM video delivery ---
# Videos use private S3-compatible storage and short-lived signed URLs.

# --- M4 manual-funding channels (server-only deployment configuration) ---
# JSON array of 1–3 approved receiving channels with non-secret account
# labels and localized student instructions. Absent = explicitly
# UNCONFIGURED: instruction/submission endpoints answer 503
# PAYMENT_UNCONFIGURED. Malformed JSON fails startup closed. Never commit
# real receiving identifiers; tests use fixture values below.
# Example:
# PAYMENT_CHANNELS=[{"channel":"INSTAPAY","accountLabel":"instapay-alias (test only)","instructionsAr":"...","instructionsEn":"..."}]
PAYMENT_CHANNELS=

# --- Browser-safe frontend settings (VITE_ prefix = bundled into client JS) ---
# Only non-secret, public values here. No database, Redis, or DRM credentials.
VITE_DEFAULT_LANG=ar
VITE_API_BASE=/api

# Private platform captions/resources; server-only, independent of DRM video storage.
# The first five values are all-or-none. Production requires HTTPS.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Timeout: 250..30000 milliseconds; retries: 0..3.
STORAGE_REQUEST_TIMEOUT_MS=5000
STORAGE_MAX_RETRIES=2

# Private student national ID storage. Generate two independent random 32-byte
# keys (base64); never reuse AUTH/DRM keys. Keep/back up these with the database.
# Both are all-or-none. Missing keys disable NEW registration/ID writes only;
# existing login/access remains available. Never change index key without a
# controlled full fingerprint migration; encrypted IDs are bound to user IDs.
STUDENT_DATA_ENCRYPTION_KEY_B64=
STUDENT_DATA_INDEX_KEY_B64=

# SEO: keep false for local/staging. Set a confirmed HTTPS origin before enabling.
SEO_PUBLIC_ORIGIN=
SEO_INDEXING_ENABLED=false
## Current release: coding IDE/practice/assessments disabled; choice quizzes stay available.
## Re-enabling requires a qualified grading host and the coding-ide Compose profile.
CODING_IDE_ENABLED=false
