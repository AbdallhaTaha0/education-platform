# Education platform — example environment (M3 catalog + DRM adapter)
# Copy to .env for local shell overrides. Compose files carry safe local
# defaults, so this file is documentation-first. NEVER put real production
# secrets here. Frontend (browser) configuration is prefixed VITE_ and must
# never contain privileged credentials.

# --- Platform PostgreSQL (server-only; never exposed to the browser) ---
# Local development default used by docker/compose.dev.yml:
#   postgresql://postgres:postgres@postgres:5432/education_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=education_platform
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/education_platform

# --- Platform Redis (server-only) ---
# Local development default: redis://redis:6379
REDIS_URL=redis://redis:6379

# --- Server runtime ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=0.3.0-m3
# Bounded per-dependency timeout (ms) for GET /health/ready checks.
READY_TIMEOUT_MS=2000

# --- Identity/auth (all server-only; never VITE_-prefixed) ---
# Strong signing secret, 32+ characters. Generate locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the real value in the ignored root .env only. Production fails
# closed when this is missing or weak.
AUTH_JWT_SECRET=
AUTH_ISSUER=edu-platform-dev
AUTH_AUDIENCE=edu-platform-dev-web
# Exact approved origins for state-changing identity requests (no wildcards).
ALLOWED_ORIGINS=http://localhost:8080
# Local Docker HTTP explicitly uses Secure=false. Production requires
# explicit COOKIE_SECURE=true and refuses to start otherwise.
COOKIE_SECURE=false
# Argon2id production cost (memory KiB, time, parallelism). Reduced values are
# accepted ONLY with NODE_ENV=test (isolated suites); development and
# production reject anything below 65536/3/4, and every environment rejects
# absurd values above 1048576/10/16.
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Public entry point ---
# Browser reaches the platform through Nginx, which serves the frontend and
# proxies /api/* to the backend. The frontend calls same-origin /api/*, so no
# browser-side backend URL is required.
PUBLIC_BASE_URL=http://localhost:8080

# --- External DRM (M3 real adapter; server-only, never VITE_) ---
# The external education-drm-service package is consumed by API only, using
# server-side X-Client-Id / X-Client-Secret headers. The three core settings
# are all-or-none: partial configuration fails startup in every environment.
# Production requires all three plus an HTTPS DRM_BASE_URL. Development/test
# may start unconfigured so non-media catalog work remains usable; when
# unconfigured, every DRM-dependent mutation fails closed with 503
# DRM_UNCONFIGURED and never fabricates success.
# Local contract tests use an explicitly labeled HTTP fixture (not real DRM).
DRM_BASE_URL=
DRM_CLIENT_ID=
DRM_CLIENT_SECRET=
# Bounded DRM HTTP timeout (ms), 250–30000, default 5000 (AbortController).
DRM_REQUEST_TIMEOUT_MS=5000
# Bounded retry budget for safe/idempotent GET + DELETE only, 0–3, default 2.
# POST register/complete are never auto-retried. Backoff is exponential with jitter.
DRM_MAX_RETRIES=2

# --- Browser-safe frontend settings (VITE_ prefix = bundled into client JS) ---
# Only non-secret, public values here. No database, Redis, or DRM credentials.
VITE_DEFAULT_LANG=ar
VITE_API_BASE=/api
