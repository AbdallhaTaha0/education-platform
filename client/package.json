{
  "name": "@education-platform/client",
  "version": "0.4.0",
  "private": true,
  "description": "Arabic-first React/TypeScript frontend (M3: public catalog + admin management).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/patch-braces.mjs --verify && tsc -b && vite build && vite build --ssr src/seo/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test scripts/patch-braces.test.mjs && node --test scripts/patch-dashjs.test.mjs && vitest run",
    "postinstall": "node scripts/patch-dashjs.mjs && node scripts/patch-braces.mjs",
    "build:vercel": "npm run build && node scripts/vercel-output.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.13",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "acorn": "^8.18.0",
    "codemirror": "^6.0.2",
    "dashjs": "5.2.1",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
