# Provider variables, not local Docker overrides. Blank fields block release.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
COOKIE_SECURE=true
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
DATABASE_URL=
REDIS_URL=
AUTH_JWT_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=
ALLOWED_ORIGINS=
STUDENT_DATA_ENCRYPTION_KEY_B64=
STUDENT_DATA_INDEX_KEY_B64=
DRM_BASE_URL=
DRM_PUBLIC_BASE_URL=
DRM_CLIENT_ID=
DRM_CLIENT_SECRET=
DRM_ASSERTION_ISSUER=
DRM_ASSERTION_AUDIENCE=drm-service
DRM_ASSERTION_PRIVATE_KEY_B64=
DRM_ASSERTION_KEY_ID=
DRM_ASSERTION_MAX_LIFETIME_SEC=120
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
PAYMENT_CHANNELS=
SEO_PUBLIC_ORIGIN=
# false on testing. Enable only with approved production canonical domain.
SEO_INDEXING_ENABLED=false
