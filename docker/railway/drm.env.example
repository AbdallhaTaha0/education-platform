# DRM API/worker variables; DRM persistence stays separate from platform.
NODE_ENV=production
PORT=3000
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=
TRUST_PROXY=1
HTTPS_REQUIRED=true
PLAYBACK_ASSERTION_REQUIRED=true
CLEAR_KEY_ENABLED=false
PREMIUM_DRM_REQUIRED=true
DRM_MASTER_KEY=
PLAYBACK_TOKEN_SECRET=
WATERMARK_SECRET=
ADMIN_API_TOKEN=
JWT_ISSUER=
JWT_AUDIENCE=drm-service
JWT_JWKS_URL=
PLAYBACK_TOKEN_TTL=300
PLAYBACK_SESSION_TTL=3600
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
WIDEVINE_LICENSE_SERVER_URL=
WIDEVINE_SIGNING_KEY=
WIDEVINE_SIGNING_IV=
WIDEVINE_PROVIDER=
WIDEVINE_CONTENT_KEY_SEED=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SHAKA_PACKAGER_PATH=packager
