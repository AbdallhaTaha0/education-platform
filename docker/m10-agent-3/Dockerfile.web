# M10 agent 3 — DISPOSABLE test-only images.
#
# Builds the current client sources with Vite and serves them together with the
# labeled synthetic ADMIN fixture (docker/m10-agent-3/fixture/web.mjs). Nothing
# here is a production substitute: the React code calls the real routes and the
# fixture only answers them inside this disposable project.
ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /srv/client
COPY client/package.json client/package-lock.json ./
COPY client/scripts ./scripts
RUN npm ci
COPY client/index.html client/vite.config.ts client/tsconfig.json client/postcss.config.js client/tailwind.config.js ./
COPY client/public ./public
COPY client/src ./src
RUN npm run build

FROM ${NODE_IMAGE} AS client-test
WORKDIR /srv/client
COPY client/package.json client/package-lock.json ./
COPY client/scripts ./scripts
RUN npm ci
COPY client/index.html client/vite.config.ts client/vitest.config.ts client/tsconfig.json client/postcss.config.js client/tailwind.config.js ./
COPY client/src ./src
CMD ["npm", "test"]

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=test
COPY --from=build /srv/client/dist /srv/web/dist
COPY docker/m10-agent-3/fixture /srv/web/fixture
ENV DIST=/srv/web/dist
EXPOSE 8080
CMD ["node", "/srv/web/fixture/web.mjs"]