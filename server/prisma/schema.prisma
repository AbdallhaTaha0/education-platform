// Platform Prisma configuration (M1).
//
// Prisma owns ONLY platform PostgreSQL tables. It must never manage the
// external DRM database, its tables, or its migrations, and platform code
// must never use DRM database credentials.
//
// M1 intentionally defines NO business models (no User, Wallet, Course, or
// Subscription tables). Those arrive with their own milestones, migrations,
// and acceptance tests per reports-and-markdown-files/schema.md. An empty
// business schema is the correct starting point: the migration pipeline
// (prisma/migrations/* + `npm run db:migrate` one-shot container) is proven
// by the m1_init migration and by real SELECT/PING readiness checks, not by
// invented domain tables.

// Platform Prisma configuration (M2 identity + M3 catalog).
//
// Prisma owns ONLY platform PostgreSQL tables. It must never manage the
// external DRM database, its tables, or its migrations, and platform code
// must never use DRM database credentials.
//
// M2 identity models (User, AuthSession, RefreshToken) provide cookie
// authentication. M3 adds the bilingual catalog (Course → Sections →
// Lessons), SubscriptionPlan with exact EGP piastres + fixed days, one
// opaque MediaMapping per lesson, durable CatalogDeletion* evidence, and
// AuditEvent. Wallet/purchase/subscription models arrive in later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Exactly two platform roles. A native enum rejects any third role at the
/// database level; application code whitelists the same two values.
enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
  wallet       Wallet?
  rechargeRequests RechargeRequest[]
  purchases    Purchase[]
  packagePurchases PackagePurchase[]
  subscriptions Subscription[]
  lessonProgress LessonProgress[]
  playbackReferences PlaybackReference[]
  notifications Notification[]
  notificationAudience NotificationAudience[]
  notificationInboxState NotificationInboxState?
  notificationExpiries NotificationExpiryMarker[]

  @@index([role])
}

/// One row per login (session family). All refresh generations of the same
/// login share this row; revoking it invalidates every token of the family
/// immediately, without waiting for access-token expiry.
model AuthSession {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfHash          String?
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  revokedAt         DateTime?
  revokeReason      String?
  refreshTokens     RefreshToken[]

  @@index([userId])
  @@index([absoluteExpiresAt])
}

/// One row per issued refresh credential. Only the SHA-256 digest of the
/// 256-bit secret is stored — raw refresh tokens never touch the database.
/// Rotation consumes the old row and inserts a new one inside a single
/// transaction: a credential succeeds at most once, and presenting an
/// already-consumed credential proves reuse and revokes the family.
model RefreshToken {
  id         String    @id @default(uuid())
  sessionId  String
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  consumed   Boolean   @default(false)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
}

/// M3 catalog lifecycle. Only PUBLISHED with no pending deletion is public.
/// ARCHIVED stores priorStatus to restore deterministically after revalidation.
enum CourseStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

/// Local media lifecycle. Maps from DRM states:
/// UPLOADED → UPLOAD_PENDING; PROCESSING/TRANCODING/PACKAGING → PROCESSING;
/// READY → READY; FAILED → FAILED; DELETING → DELETION_PENDING;
/// DELETE_FAILED → DELETION_FAILED. UNREGISTERED is the pre-registration
/// placeholder (no row exists yet in practice; kept for state-matrix tests).
enum MediaState {
  UNREGISTERED
  UPLOAD_PENDING
  PROCESSING
  READY
  FAILED
  DELETION_PENDING
  DELETION_FAILED
}

/// Durable platform deletion operation state.
enum CatalogDeletionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Permanent-deletion target type snapshot.
enum CatalogDeletionTarget {
  COURSE
  SECTION
  LESSON
}

model Course {
  id                  String       @id @default(uuid())
  slug                String       @unique
  titleAr             String
  titleEn             String
  descriptionAr       String
  descriptionEn       String
  status              CourseStatus @default(DRAFT)
  priorStatus         CourseStatus?
  publishedAt         DateTime?
  firstPublicationAt  DateTime?
  archivedAt          DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sections            CourseSection[]
  plans               SubscriptionPlan[]
  grade               String?
  academicYear        String?
  term                Int?
  courseKind          String?
  teachingMonth       String?
  packageMembers      PackageMember[]

  @@index([grade, academicYear, term, courseKind])

  @@index([status])
  @@index([deletionRequestedAt])
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr   String
  titleEn   String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]

  @@unique([courseId, position])
  @@index([courseId, position])
}

model Lesson {
  id        String        @id @default(uuid())
  sectionId String
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleAr   String
  titleEn   String
  position  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  media     MediaMapping?
  progress  LessonProgress[]
  playbackReferences PlaybackReference[]

  @@unique([sectionId, position])
  @@index([sectionId, position])
}

/// Exact EGP prices in piastres (integer only, no floats) + fixed days.
/// previousPricePiastres null disables the visual offer; when present it
/// must be strictly greater than currentPricePiastres. durationDays 1–3650.
model SubscriptionPlan {
  id                    String   @id @default(uuid())
  courseId              String
  course                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentPricePiastres  Int
  previousPricePiastres Int?
  durationDays          Int?
  accessMode            AccessMode @default(DURATION)
  accessEndsAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([courseId])
}

/// One opaque external DRM mapping per lesson. Never persists signed upload
/// URLs, storage keys, client secrets, or DRM internals. errorCategory is a
/// safe token (e.g. TIMEOUT/NETWORK/SERVER/VALIDATION), never raw bodies.
model MediaMapping {
  id                String     @id @default(uuid())
  lessonId          String     @unique
  lesson            Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  externalAssetId   String     @unique
  assetId           String?    @unique
  status            MediaState @default(UPLOAD_PENDING)
  idempotencyKey    String     @unique
  uploadCompletedAt DateTime?
  lastSyncedAt      DateTime?
  errorCategory     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([assetId])
}

/// Durable catalog deletion operation. No FK to Course/Section/Lesson so
/// evidence survives after target rows are gone; targetId is a snapshot.
model CatalogDeletionOperation {
  id            String                  @id @default(uuid())
  targetType    CatalogDeletionTarget
  targetId      String
  /// Owning course for course-scoped active-operation guard + visibility
  /// recovery. NULL only for legacy evidence whose target is already gone.
  courseId      String?
  requestedBy   String
  status        CatalogDeletionStatus   @default(PENDING)
  errorCategory String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  completedAt   DateTime?
  assets        CatalogDeletionAsset[]

  @@index([targetType, targetId])
  @@index([status])
  @@index([courseId])
}

/// Per-asset deletion evidence snapshot. drmDeletionId is the DRM
/// media-deletions operation id; lastState is the last observed DRM state.
model CatalogDeletionAsset {
  id             String                    @id @default(uuid())
  operationId    String
  operation      CatalogDeletionOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  mappingId      String
  drmAssetId     String?
  externalAssetId String
  drmDeletionId  String?
  lastState      String?
  attemptCount   Int                       @default(0)
  lastCheckedAt  DateTime?
  errorCategory  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([operationId])
  @@index([drmDeletionId])
}

/// M4 manual-funding channel. Receiving identifiers are runtime config,
/// never code. Reference uniqueness is scoped per channel (D21).
enum RechargeChannel {
  INSTAPAY
  BANK_TRANSFER
  MOBILE_WALLET
}

/// M4 recharge review state. Rejection is terminal and immutable;
/// resubmission creates a new request (D21).
enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// M4 ledger entry kind. The ledger is append-only; refunds, reversals and
/// correction credits do not exist in M4 (D21).
enum LedgerEntryType {
  CREDIT_RECHARGE
  DEBIT_PURCHASE
}

/// M4 student EGP wallet. balancePiastres is a cache updated in the same
/// transaction as ledger writes and must reconcile exactly with entries.
/// All money is integer piastres (minor units); floats are forbidden.
model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePiastres  Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  entries          WalletLedgerEntry[]
}

/// M4 append-only auditable ledger. Exactly-once per source is enforced by
/// the [refType, refId] unique constraint in addition to service checks.
model WalletLedgerEntry {
  id              String           @id @default(uuid())
  walletId        String
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountPiastres  Int
  entryType       LedgerEntryType
  refType         String
  refId           String
  createdAt       DateTime         @default(now())

  @@unique([refType, refId])
  @@index([walletId])
}

/// M4 manual recharge request. Pending requests never create credit.
/// Approval credits once and never auto-purchases. Proof bytes live in
/// RechargeProof; this row keeps metadata visible to the owning student.
model RechargeRequest {
  id               String          @id @default(uuid())
  studentId        String
  student          User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountPiastres   Int
  channel          RechargeChannel
  referenceNorm    String
  senderName       String
  senderPhone      String
  transferDate     DateTime
  proofFilename    String
  proofMime        String
  proofSize        Int
  proofHash        String
  status           RechargeStatus  @default(PENDING)
  reviewerId       String?
  reviewedAt       DateTime?
  notificationRecordedAt DateTime?
  rejectReason     String?
  /// Student-owned idempotency key: retries return the same request.
  idempotencyKey   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  proof            RechargeProof?

  @@unique([channel, referenceNorm])
  @@unique([studentId, idempotencyKey])
  @@index([studentId, status])
  @@index([status])
}

/// M4 private proof storage, separated from request/audit metadata.
/// bytes is cleared (NULL) by the retention job 180 days after review;
/// metadata + sanitized audit trail are retained. Never served to students.
model RechargeProof {
  requestId String   @id
  request   RechargeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bytes     Bytes?
  mime      String
  size      Int
  hash      String
  cleanedAt DateTime?
  createdAt DateTime @default(now())
}

/// M4 purchase snapshot. planId/courseId/price/duration are historical
/// truth copied at purchase time (plain strings/ints, no FKs): later plan
/// edits or deletions never rewrite an existing purchase (D14/D04).
model Purchase {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId          String
  courseId        String
  pricePiastres   Int
  durationDays    Int?
  accessMode      AccessMode @default(DURATION)
  accessEndsAt    DateTime?
  /// Student-owned idempotency key: retries return the same purchase.
  idempotencyKey  String
  createdAt       DateTime @default(now())

  @@unique([studentId, idempotencyKey])
  @@index([studentId])
}

/// M4 course entitlement. Active renewal extends from the current expiry;
/// expired renewal starts immediately (backend time, integer days, D04).
model Subscription {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  purchaseId String?   @unique
  packagePurchaseId String?
  packagePurchase PackagePurchase? @relation(fields: [packagePurchaseId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([studentId, courseId])
  @@unique([packagePurchaseId, courseId])
}

enum AccessMode {
  DURATION
  TERM_END
  YEAR_END
  UNTIL_REMOVAL
}

model CoursePackage {
  id String @id @default(uuid())
  titleAr String
  titleEn String
  descriptionAr String
  descriptionEn String
  status String @default("DRAFT")
  pricePiastres Int
  endsAt DateTime
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members PackageMember[]
}

model PackageMember {
  packageId String
  package CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position Int
  @@id([packageId, courseId])
  @@unique([packageId, position])
}

// Historical snapshots intentionally have no live package/course foreign keys.
model PackagePurchase {
  id String @id @default(uuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId String
  version Int
  titleAr String
  titleEn String
  pricePiastres Int
  endsAt DateTime
  idempotencyKey String
  createdAt DateTime @default(now())
  items PackagePurchaseItem[]
  subscriptions Subscription[]
  @@unique([studentId, idempotencyKey])
  @@index([studentId, createdAt])
}

model PackagePurchaseItem {
  purchaseId String
  purchase PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  courseId String
  titleAr String
  titleEn String
  position Int
  @@id([purchaseId, courseId])
  @@unique([purchaseId, position])
}

/// Sanitized audit trail. metadata is JSON but must never contain cookies,
/// auth headers, secrets, signed URLs, credentials, storage keys, or raw
/// external bodies — enforced in service code + tests.
model AuditEvent {
  id         String   @id @default(uuid())
  actorUserId String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  metadata   Json?

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// M5 protected learning. Learning progress and playback references are
/// durable platform records; they are NEVER an authorization input. Access is
/// always decided by the subscription entitlement at backend time.
enum PlaybackSessionStatus {
  ACTIVE
  ENDED
  TERMINATED
  TERMINATION_FAILED
}

enum TerminationStatus {
  PENDING
  COMPLETED
  FAILED
  NOT_REQUIRED
}

/// Why an active DRM session still needs a termination call.
enum PlaybackEndReason {
  /// The viewer closed or finished the lesson normally.
  VIEWER_END
  /// The subscription lapsed while the session was open.
  SUBSCRIPTION_EXPIRED
}

/// Minimal per-student learning progress (M5). A stored position or completion
/// record never grants access. Values are seconds, finite and non-negative.
model LessonProgress {
  id              String    @id @default(uuid())
  studentId       String
  student         User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId        String
  positionSeconds Float     @default(0)
  durationSeconds Float?
  completedAt     DateTime?
  lastAccessedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, courseId])
  @@index([studentId, lastAccessedAt])
}

/// Non-secret reference to an external DRM playback session.
///
/// The DRM playback bearer token is NEVER stored here, in any other platform
/// table, in Redis, or in audit metadata. Only the opaque external session id
/// and lifecycle timestamps are durable, so expiry reconciliation can request
/// supported external termination after entitlement lapses.
model PlaybackReference {
  id                    String               @id @default(uuid())
  studentId             String
  student               User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId              String
  lesson                Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId              String
  externalSessionId     String               @unique
  externalAssetId       String
  provider              String
  status                PlaybackSessionStatus @default(ACTIVE)
  terminationStatus     TerminationStatus?
  /**
   * Why the platform still owes the DRM a termination call. A normal viewer end
   * must still be confirmed by the dependency, so a failed confirmation is
   * retried rather than forgotten; the reason decides whether a successful
   * termination lands as ENDED (viewer finished) or TERMINATED (entitlement
   * lapsed). Null means there is nothing outstanding.
   */
  pendingEndReason      PlaybackEndReason?
  terminationAttempts   Int                  @default(0)
  nextTerminationAt     DateTime?
  lastErrorCategory     String?
  tokenExpiresAt        DateTime
  sessionExpiresAt      DateTime
  endedAt               DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([studentId, status])
  @@index([status, nextTerminationAt])
  @@index([studentId, courseId])
  @@index([courseId, status])
}

/// M6 durable notification intent. Only platform references are stored;
/// there are no credential, proof, free-text or external DRM payload fields.
enum NotificationType {
  RECHARGE_APPROVED
  RECHARGE_REJECTED
  COURSE_PUBLISHED
  SUBSCRIPTION_EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model NotificationEvent {
  id                String @id @default(uuid())
  eventKey          String @unique
  type              NotificationType
  schemaVersion     Int @default(1)
  courseId          String?
  occurredAt        DateTime
  recordedAt        DateTime @default(now())
  expiresAt         DateTime
  deliveryStatus    NotificationDeliveryStatus @default(PENDING)
  nextAttemptAt     DateTime @default(now())
  attemptCount      Int @default(0)
  leaseToken        String?
  leaseExpiresAt    DateTime?
  fanoutCursor      String?
  lastErrorCategory String?
  audience          NotificationAudience[]

  @@index([deliveryStatus, nextAttemptAt, id])
  @@index([expiresAt])
}

/// Frozen recipients. A notice cannot exist without this owning audience row.
model NotificationAudience {
  eventId        String
  event          NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  materializedAt DateTime?
  notification   Notification?

  @@id([eventId, recipientId])
  @@index([recipientId])
}

model Notification {
  id                String @id @default(uuid())
  eventId           String
  recipientId       String
  audience          NotificationAudience @relation(fields: [eventId, recipientId], references: [eventId, recipientId], onDelete: Cascade)
  recipient         User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientSequence BigInt
  createdAt         DateTime
  occurredAt        DateTime
  expiresAt         DateTime
  readAt            DateTime?
  signalPending     Boolean @default(true)
  signalAttempts    Int @default(0)
  nextSignalAt      DateTime @default(now())

  @@unique([eventId, recipientId])
  @@unique([recipientId, recipientSequence])
  @@index([recipientId, readAt, expiresAt])
  @@index([expiresAt])
  @@index([signalPending, nextSignalAt, id])
}

/// Monotonic allocation and read-all fence; every inbox writer locks this row.
model NotificationInboxState {
  userId       String @id
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSequence BigInt @default(0)
  revision     BigInt @default(0)
  deliveredRevision BigInt @default(0)
  signalLeaseToken String?
  signalLeaseExpiresAt DateTime?
  signalNextAttemptAt DateTime @default(now())
  signalAttemptCount Int @default(0)
  updatedAt    DateTime @updatedAt
}

/// Minimal durable boundary evidence; never a copy of notice content.
model NotificationExpiryMarker {
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId String
  recordedExpiry DateTime
  @@id([studentId, courseId])
}

/// Singleton activation fence: no historical notification backfill.
model NotificationRollout {
  id Int @id
  installedAt DateTime
}
