{
  "name": "@education-platform/server",
  "version": "0.4.0",
  "private": true,
  "description": "Modular Express/TypeScript backend (M3: catalog + DRM adapter). One application image; replicas share it behind Nginx.",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bootstrap:admin": "node dist/bootstrap.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ci": "npm run test:unit --silent && npm run test:integration --silent"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.2.0",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.0.0",
    "socket.io-client": "4.8.3",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
